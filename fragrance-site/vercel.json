{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "regions": ["cdg1"],
  "git": { "deploymentEnabled": false },
  "functions": {
    "api/signup.js": { "maxDuration": 15 }
  },
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": false },
    { "source": "/index-backup.html", "destination": "/", "permanent": false },
    { "source": "/homepage.html", "destination": "/", "permanent": false },
    { "source": "/landing.html", "destination": "/", "permanent": false },
    { "source": "/shop.html", "destination": "/", "permanent": false },
    { "source": "/products.html", "destination": "/", "permanent": false },
    { "source": "/about.html", "destination": "/", "permanent": false },
    { "source": "/contact.html", "destination": "/", "permanent": false },
    { "source": "/checkout.html", "destination": "/", "permanent": false },
    { "source": "/order-confirmation.html", "destination": "/", "permanent": false },
    { "source": "/privacy-policy.html", "destination": "/", "permanent": false },
    { "source": "/returns.html", "destination": "/", "permanent": false },
    { "source": "/shipping.html", "destination": "/", "permanent": false },
    { "source": "/terms.html", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
