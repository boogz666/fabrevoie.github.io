# Cloud signup storage. Configure real values in Vercel; never commit them.
DATABASE_URL=
RATE_LIMIT_SECRET=
# Optional canonical production origin, e.g. https://your-brand.example
PUBLIC_SITE_URL=
PUBLIC_ORIGIN=

# Payments stay off until all commercial and tax settings have been approved.
# disabled (default) | test (clearly labeled sandbox) | live
COMMERCE_MODE=disabled
STRIPE_SECRET_KEY=
# Hosted Checkout does not need a publishable key in the browser.
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Comma-separated, existing Stripe shipping-rate IDs and ISO country codes.
STRIPE_SHIPPING_RATE_IDS=
COMMERCE_ALLOWED_SHIPPING_COUNTRIES=
COMMERCE_DISPATCH_NOTICE=
COMMERCE_QUANTITY_MAX=3
# Independent random secret, at least 32 characters. Keep stable for order retries.
ORDER_TOKEN_SECRET=
